    "version": "0.2.0",
    "configurations": [
        {
          "name": "Debug",
          "type": "node",
          "request": "launch",
          "protocol": "inspector",
          "outputCapture": "std",
          "cwd": "${workspaceRoot}",
          "runtimeExecutable": "${workspaceRoot}/node_modules/.bin/ts-node-dev.cmd",
          "args": ["--transpile-only", "${workspaceRoot}/src/app.ts"],
          "restart": true
        }
      ]
}